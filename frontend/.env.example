# Optional settings for running the frontend without Docker (pnpm dev / pnpm build).
# Copy to .env and change what you need. Every value below is the default.

# Where the browser finds the API. A path means "same origin as this page",
# which is what both the Vite dev server and the reverse proxy provide.
VITE_API_URL=/api

# Development only: where the Vite dev server forwards /api requests,
# i.e. where the Laravel backend is listening.
API_PROXY_TARGET=http://localhost:8000
