APP_NAME="Series API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

SESSION_DRIVER=array

QUEUE_CONNECTION=sync

# file needs nothing else; with redis, set REDIS_HOST (the Docker setups do).
CACHE_STORE=file
# REDIS_HOST=127.0.0.1

# Other origins allowed to call the API from a browser (comma separated). Empty = none, * = any.
CORS_ALLOWED_ORIGINS=

# Where shows come from. Only "tvmaze" exists today.
SHOWS_PROVIDER=tvmaze
# Seconds a successful answer of the provider is reused.
SHOWS_SEARCH_CACHE_TTL=600
SHOWS_DETAIL_CACHE_TTL=3600

TVMAZE_BASE_URL=https://api.tvmaze.com
# TVMaze asks API clients to identify themselves.
TVMAZE_USER_AGENT=series-api/1.0
# Seconds to wait for the connection, and for the whole answer.
TVMAZE_CONNECT_TIMEOUT=3
TVMAZE_TIMEOUT=5
# Total tries per request (1 = no retry) and milliseconds between them.
# Only network errors and 5xx are retried.
TVMAZE_ATTEMPTS=2
TVMAZE_RETRY_SLEEP_MS=200
