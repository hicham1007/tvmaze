# Optional settings for docker compose (defaults shown). Copy to .env to change them.

# Port where the application is published.
APP_PORT=8080

# on  = the API only answers requests made by our own frontend
# off = it also answers curl, Postman, or a URL typed in the address bar.
API_SAME_ORIGIN_ONLY=off

# Other websites allowed to call the API from a browser (CORS), comma separated.
# Empty = none. * = any website.
CORS_ALLOWED_ORIGINS=
